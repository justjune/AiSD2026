SHELL := cmd.exe

EXEFILE = L0712_255.exe
OBJFILES = L0701_241_L0709_253.o L0712_255.o L0712_255main.o

$(EXEFILE): $(OBJFILES)
	$(CXX) -o $(EXEFILE) $(OBJFILES)

L0701_241_L0709_253.o: ../L0710_254/L0701_241_L0709_253.cpp
	$(CXX) -c ../L0710_254/L0701_241_L0709_253.cpp

L0712_255.o: L0712_255.cpp
	$(CXX) -c L0712_255.cpp

L0712_255main.o: L0712_255main.cpp
	$(CXX) -c L0712_255main.cpp

.PHONY: clean run all
clean:
	rm -f $(OBJFILES) $(EXEFILE)
run:
	$(EXEFILE)
all: $(EXEFILE) run clean